{
  "configurations": [
    {
      "type": "mcuxpresso-debug",
      "name": "Debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": {
        "elf": ""
      },
                   "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 2
            },
      "stopAtSymbol": "main",
      "probeSerialNumber": "",
      "isAttach": false,
      "skipBuildBeforeDebug": false,
      "gdbInitCommands": [
        "set remotetimeout 600",
        "set debug-file-directory",
        "set non-stop off"
      ],
      "gdbServerConfigs": {
        "linkserver": {
          "device": "K32L2A41xxxxA:FRDM-K32L2A4S"
        },
        "segger": {},
        "pemicro": {}
      },
      "showDevDebugOutput": "none"

    }
  ]
}